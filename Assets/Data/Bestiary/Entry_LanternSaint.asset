  id: lantern_saint
  displayName: The Lantern Saint
  classification: Relic-spirit
  lore: A votive flame that outlived its church. Draws moths, stops clocks and leaves
    wax on the sills of people who pray too late at night.
  symptoms:
  - flickering electronics
  - moths in sealed rooms
  - stopped clocks
  weaknessText: Snuff the votive with bare fingers. No glove, no breath.
  weaknessTool: {fileID: 0}
  handwritten: 0
  hiddenUntilItsCase: 0
