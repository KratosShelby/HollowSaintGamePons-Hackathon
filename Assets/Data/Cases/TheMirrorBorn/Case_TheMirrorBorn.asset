  id: the_mirror_born
  title: Room 414
  sceneName: Hotel
  entity: {fileID: 11400000, guid: af17dad894437724c97c7d0a33d11ba6, type: 2}
  clues:
  - {fileID: 11400000, guid: 850148cdf23ebc1478fc9a7cafd88039, type: 2}
