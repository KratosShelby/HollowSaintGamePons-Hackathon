  id: the_echo
  title: The Echo
  sceneName: Case_Echo
  entity: {fileID: 11400000, guid: cd867456e2e426b4d88ef104e1f4909f, type: 2}
  clues:
  - {fileID: 11400000, guid: 9d7043b12fac72f4589c09d82109f1a4, type: 2}
